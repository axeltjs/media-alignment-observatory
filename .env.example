PORT=8080
CORS_ORIGIN=*

# ---------------------------------------------------------------
# Database — DB_CONNECTION menentukan driver yang digunakan
# ---------------------------------------------------------------

DB_CONNECTION=sqlite   # sqlite | pgsql

# SQLite (default)
DB_DATABASE=maoi.db

# PostgreSQL (aktif kalau DB_CONNECTION=pgsql)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=maoi
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------
# Embedding API (Ollama default — run: ollama pull nomic-embed-text)
# ---------------------------------------------------------------
EMBEDDING_API_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=

# ---------------------------------------------------------------
# Anthropic Claude — LLM-based framing & narrative analysis
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
